      "PartitionCapacity": 50
    },
    "Host": "localhost",
    "Port": 5672,
    "PrefetchCount": 100,
    "QueueName": "telemetry.events"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
